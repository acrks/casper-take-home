generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Trip {
  id          String   @id @default(cuid())
  name        String
  destination String
  startDate   DateTime
  endDate     DateTime
  description String?
  organizerId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}